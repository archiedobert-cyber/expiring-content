name: Expiring Content Checker
on:
  workflow_dispatch:
    inputs:
      force:
        description: "Ignore today's dedup state and send again (for testing)"
        required: false
        default: false
        type: boolean
  schedule:
    # Runs are in UTC. This targets roughly 9am UK — 9 hours before the
    # 6pm daily expiry. UK clocks shift for daylight saving, so actual
    # local time may drift by an hour for part of the year — adjust if
    # that matters to you.
    - cron: "0 8 * * *"  # daily digest
permissions:
  contents: write
jobs:
  check-expiring-content:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests

      - name: Run FC26 expiry checker
        env:
          DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
          DISCORD_ROLE_ID: ${{ secrets.DISCORD_ROLE_ID }}
        run: python fc26_expiry.py ${{ github.event.inputs.force == 'true' && '--force' || '' }}

      - name: Commit updated state
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          if [ -f state.json ]; then
            git add state.json
            git diff --staged --quiet || git commit -m "Update state"
            git push
          else
            echo "No state.json present yet (nothing was posted this run) — nothing to commit."
          fi
